# ─── Database (Hostinger MySQL) ────────────────────────────────────────────
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DBNAME"

# ─── Auth ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ─── Site ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://ydurya.com"
NEXT_PUBLIC_SITE_NAME="YDURYA"

# ─── Shipping ─────────────────────────────────────────────────────────────
# Fulfilment is handled outside the app: staff enter courier, tracking number
# and expected delivery in Admin -> Orders. "manual" is the only value today;
# a carrier integration can be registered later in src/services/shipping/.
SHIPPING_PROVIDER="manual"

# ─── Payments & checkout ────────────────────────────────────────────────
# Set PAYMENT_PROVIDER to whichever gateway is configured below. "manual"
# (the default) hides prepaid entirely - COD keeps working, and no order is
# ever auto-marked as paid.
PAYMENT_PROVIDER="cashfree"        # cashfree | fastrr | manual
NEXT_PUBLIC_PAYMENT_PROVIDER="cashfree"

# ── Cashfree Payment Gateway (docs.cashfree.com) ───────────────────────────
# Publicly documented REST API + official JS SDK, built for custom web apps -
# not a platform-specific plugin. Get client id/secret from the Cashfree
# merchant dashboard (Developers -> API Keys).
PAYMENT_API_KEY=""                 # Cashfree x-client-id
PAYMENT_SECRET=""                  # Cashfree x-client-secret (also signs webhooks)

# Sandbox by default. Switch to production before taking real orders:
# https://api.cashfree.com/pg
CASHFREE_BASE_URL="https://sandbox.cashfree.com/pg"
# One Click Checkout requires 2025-01-01 or later.
CASHFREE_API_VERSION="2025-01-01"
# One Click Checkout: Cashfree signs the customer in by phone number and
# pre-fills their delivery address from its saved-address network, so our own
# checkout stops asking for one on prepaid orders. Requires the product to be
# active in Merchant Dashboard > Payment Gateway > PG Products.
# COD is unaffected: it has no payment step, so the address is always
# collected by our form there.
CASHFREE_ONE_CLICK_CHECKOUT="true"
NEXT_PUBLIC_CASHFREE_MODE="sandbox"  # sandbox | production - passed to the JS SDK

# Configure your webhook URL in the Cashfree dashboard as:
#   https://<your-domain>/api/webhooks/payment
# Signature: base64(HMAC-SHA256(PAYMENT_SECRET, x-webhook-timestamp + rawBody)) -
# verified against Cashfree's own published reference implementation.

# ── Fastrr / Shiprocket Checkout (alternative gateway) ─────────────────────
# Matches Fastrr's own "Full checkout custom Integration APIs [PUBLIC]"
# Postman collection - confirmed with Shiprocket support, not guessed. Kept
# available as a second PaymentProvider; set PAYMENT_PROVIDER="fastrr" and
# fill in the same PAYMENT_API_KEY / PAYMENT_SECRET pair above to use it
# instead of Cashfree.
#
# Staging by default. Switch to the production base URL before taking real
# orders: https://checkout-api.shiprocket.com
PAYMENT_BASE_URL="https://fastrr-api-dev.pickrr.com"

# REST paths - real, taken directly from Fastrr's collection. Overridable only
# in case your account is on a different revision of the API.
FASTRR_PATH_CREATE="/api/v1/access-token/checkout"
FASTRR_PATH_STATUS="/api/v1/custom-platform-order/details"
FASTRR_PATH_TRANSACTIONS="/api/v1/custom-platform-order/details/transactions"
# No FASTRR_PATH_REFUND: this API has no refund endpoint. Refunds go through
# the Shiprocket dashboard, or the underlying gateway, until Shiprocket adds one.

# Fastrr's checkout UI bundle + stylesheet ("Checkout UI Flow" in their
# collection). HeadlessCheckout.addToCart(event, token) opens their UI
# in-page, using the token our server gets back from FASTRR_PATH_CREATE.
# Only used when PAYMENT_PROVIDER="fastrr".
#
#   staging     https://customcheckoutfastrr.netlify.app/assets/js/channels/shopify.js
#               https://customcheckoutfastrr.netlify.app/assets/styles/shopify.css
#   production  https://checkout-ui.shiprocket.com/assets/js/channels/shopify.js
#               https://checkout-ui.shiprocket.com/assets/styles/shopify.css
NEXT_PUBLIC_FASTRR_SDK_URL=""
NEXT_PUBLIC_FASTRR_SDK_CSS_URL=""

# ─── Media storage (local Hostinger disk) ─────────────────────────────────
UPLOAD_DIR="./public/uploads"
NEXT_PUBLIC_UPLOAD_PATH="/uploads"
MAX_UPLOAD_MB="8"

# ─── Scheduled cleanup ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# Authorizes POST /api/cron/expire-orders, which releases stock reserved by
# checkouts nobody finished paying for. Schedule it to run every 10-15
# minutes with:
#   curl -X POST https://<your-domain>/api/cron/expire-orders \
#     -H "Authorization: Bearer $CRON_SECRET"
# Left empty, the route refuses every request rather than being reachable
# with no auth.
CRON_SECRET=""

# ─── Analytics (optional; left empty = no-op provider) ────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
